gradient(to right,#000 0%,transparent 30%,transparent 70%,#000 100%);\n}\n\n.orbit {\nposition:absolute;\nborder:1px solid rgba(95,95,95,.18);\nborder-radius:50%;\nwill-change:transform;\n}\n\n.orbit::before,\n.orbit::after {\ncontent:\"\";\nposition:absolute;\nborder-radius:50%;\nbackground:linear-gradient(145deg,#ffffff,#bdbdbd);\nbox-shadow:\ninset -2px -2px 5px rgba(51,51,51,.13),\n0 4px 10px rgba(51,51,51,.08);\n}\n\n.orbit::before {\nwidth:9px;\nheight:9px;\ntop:12%;\nleft:21%;\n}\n\n.orbit::after {\nwidth:6px;\nheight:6px;\nright:14%;\nbottom:23%;\n}\n\n.orbit.o1 {\nwidth:clamp(130px,17vw,245px);\nheight:clamp(130px,17vw,245px);\nleft:-4%;\ntop:9%;\ntransform:translate3d(calc(var(--px) * 7px), calc(var(--py) * 6px), 0) rotate(-18deg);\n}\n\n.orbit.o2 {\nwidth:clamp(105px,14vw,200px);\nheight:clamp(105px,14vw,200px);\nright:-2%;\ntop:30%;\ntransform:translate3d(calc(var(--px) * -7px), calc(var(--py) * 5px), 0) rotate(32deg);\n}\n\n.orbit.o3 {\nwidth:clamp(90px,12vw,165px);\nheight:clamp(90px,12vw,165px);\nleft:8%;\nbottom:-3%;\nopacity:.65;\ntransform:translate3d(calc(var(--px) * 5px), calc(var(--py) * -5px), 0) rotate(22deg);\n}\n\n.disc {\nposition:absolute;\nwidth:clamp(62px,7.5vw,110px);\naspect-ratio:1;\nborder-radius:50%;\nbackground:\nradial-gradient(circle at 37% 31%, rgba(255,255,255,.95), transparent 18%),\nradial-gradient(circle at center, transparent 0 28%, rgba(255,255,255,.42) 29% 31%, transparent 32%),\nconic-gradient(\nfrom 20deg,\n#f9f9f9,\n#b8b8b8,\n#eeeeee,\n#8f8f8f,\n#ffffff,\n#b5b5b5,\n#f3f3f3\n);\nborder:1px solid rgba(95,95,95,.2);\nbox-shadow:\n0 12px 25px rgba(51,51,51,.09),\ninset 0 0 9px rgba(255,255,255,.65);\nopacity:.74;\nwill-change:transform;\n}\n\n.disc::after {\ncontent:\"\";\nposition:absolute;\nwidth:18%;\nheight:18%;\nleft:41%;\ntop:41%;\nborder-radius:50%;\nbackground:#f9f9f9;\nbox-shadow:inset 0 0 0 1px rgba(95,95,95,.18);\n}\n\n.disc.d1 {\nleft:5%;\ntop:40%;\ntransform:translate3d(calc(var(--px) * 6px), calc(var(--py) * 4px), 0) rotate(-12deg);\n}\n\n.disc.d2 {\nright:7%;\ntop:7%;\nwidth:clamp(82px,9.5vw,138px);\ntransform:translate3d(calc(var(--px) * -8px), calc(var(--py) * 6px), 0) rotate(17deg);\n}\n\n.disc.d3 {\nright:4%;\nbottom:4%;\nwidth:clamp(72px,8.5vw,122px);\nopacity:.6;\ntransform:translate3d(calc(var(--px) * -6px), calc(var(--py) * -5px), 0) rotate(-25deg);\n}\n\n.crystal {\nposition:absolute;\nwidth:clamp(28px,3.5vw,52px);\nheight:clamp(58px,7vw,105px);\nclip-path:polygon(50% 0, 86% 25%, 73% 82%, 50% 100%, 27% 82%, 14% 25%);\nbackground:\nlinear-gradient(\n115deg,\nrgba(255,255,255,.9) 0 18%,\nrgba(214,214,214,.75) 19% 43%,\nrgba(255,255,255,.95) 44% 59%,\nrgba(158,158,158,.65) 60% 78%,\nrgba(243,243,243,.9) 79% 100%\n);\nborder:1px solid rgba(95,95,95,.18);\nopacity:.58;\nfilter:drop-shadow(0 7px 9px rgba(51,51,51,.08));\nwill-change:transform;\n}\n\n.crystal.c1 {\nleft:20%;\ntop:14%;\ntransform:translate3d(calc(var(--px) * 5px), calc(var(--py) * 6px), 0) rotate(-21deg);\n}\n\n.crystal.c2 {\nright:21%;\nbottom:12%;\ntransform:translate3d(calc(var(--px) * -5px), calc(var(--py) * -5px), 0) rotate(18deg);\n}\n\n.crystal.c3 {\nright:17%;\ntop:50%;\nwidth:clamp(20px,2.6vw,38px);\nheight:clamp(42px,5vw,74px);\nopacity:.44;\ntransform:translate3d(calc(var(--px) * -4px), calc(var(--py) * 3px), 0) rotate(-10deg);\n}\n\n.star {\nposition:absolute;\nwidth:12px;\nheight:12px;\nopacity:.28;\nwill-change:transform;\n}\n\n.star::before,\n.star::after {\ncontent:\"\";\nposition:absolute;\nleft:50%;\ntop:50%;\nbackground:#777;\nborder-radius:50%;\ntransform:translate(-50%,-50%);\n}\n\n.star::before {\nwidth:1px;\nheight:100%;\n}\n\n.star::after {\nwidth:100%;\nheight:1px;\n}\n\n.star.s1 { left:29%; top:19%; }\n.star.s2 { right:29%; top:22%; transform:rotate(45deg); }\n.star.s3 { left:26%; bottom:21%; transform:rotate(20deg); }\n.star.s4 { right:31%; bottom:26%; transform:rotate(60deg); }\n.star.s5 { left:17%; top:66%; transform:rotate(40deg); }\n.star.s6 { right:16%; top:68%; transform:rotate(15deg); }\n\n.ring {\nposition:absolute;\nwidth:10px;\nheight:10px;\nmargin-left:-5px;\nmargin-top:-5px;\nborder:1px solid rgba(95,95,95,.38);\nborder-radius:50%;\nopacity:0;\n}\n\n.ring.active {\nanimation:ring .9s ease-out forwards;\n}\n\n.particle {\nposition:absolute;\nwidth:5px;\nheight:5px;\nborder-radius:50%;\nbackground:linear-gradient(145deg,#ffffff,#9e9e9e);\nborder:1px solid rgba(95,95,95,.16);\nopacity:0;\n}\n\n@keyframes ring {\nfrom {\nopacity:.48;\ntransform:translate3d(0,0,0) scale(.2);\n}\nto {\nopacity:0;\ntransform:translate3d(0,0,0) scale(8);\n}\n}\n\n@media (prefers-reduced-motion: reduce) {\n.sheen,\n.orbit,\n.disc,\n.crystal {\ntransform:none !important;\n}\n\n.ring.active {\nanimation-duration:1ms;\n}\n} </style>\n\n</head>\n<body>\n<div class=\"scene\" id=\"scene\">\n  <div class=\"mesh\"></div>\n  <div class=\"sheen\"></div>\n\n  <div class=\"orbit o1\"></div>\n  <div class=\"orbit o2\"></div>\n  <div class=\"orbit o3\"></div>\n\n  <div class=\"disc d1\"></div>\n  <div class=\"disc d2\"></div>\n  <div class=\"disc d3\"></div>\n\n  <div class=\"crystal c1\"></div>\n  <div class=\"crystal c2\"></div>\n  <div class=\"crystal c3\"></div>\n\n  <div class=\"star s1\"></div>\n  <div class=\"star s2\"></div>\n  <div class=\"star s3\"></div>\n  <div class=\"star s4\"></div>\n  <div class=\"star s5\"></div>\n  <div class=\"star s6\"></div>\n\n  <div class=\"ring\" id=\"ring\"></div>\n</div>\n\n<script>\n(() => {\n  const scene = document.getElementById(\"scene\");\n  const ring = document.getElementById(\"ring\");\n  const reduced = matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n\n  let tx = 0;\n  let ty = 0;\n  let cx = 0;\n  let cy = 0;\n  let raf = 0;\n\n  function animate() {\n    cx += (tx - cx) * 0.055;\n    cy += (ty - cy) * 0.055;\n\n    scene.style.setProperty(\"--px\", cx.toFixed(4));\n    scene.style.setProperty(\"--py\", cy.toFixed(4));\n\n    raf = requestAnimationFrame(animate);\n  }\n\n  if (!reduced) {\n    raf = requestAnimationFrame(animate);\n  }\n\n  addEventListener(\"pointermove\", event => {\n    if (reduced) return;\n\n    const w = Math.max(1, innerWidth);\n    const h = Math.max(1, innerHeight);\n\n    tx = Math.max(-1, Math.min(1, (event.clientX / w - .5) * 2));\n    ty = Math.max(-1, Math.min(1, (event.clientY / h - .5) * 2));\n  }, { passive:true });\n\n  addEventListener(\"pointerleave\", () => {\n    tx = 0;\n    ty = 0;\n  }, { passive:true });\n\n  addEventListener(\"pointerdown\", event => {\n    const x = Math.max(0, Math.min(innerWidth, event.clientX));\n    const y = Math.max(0, Math.min(innerHeight, event.clientY));\n\n    ring.classList.remove(\"active\");\n    ring.style.left = x + \"px\";\n    ring.style.top = y + \"px\";\n    void ring.offsetWidth;\n    ring.classList.add(\"active\");\n\n    if (!reduced) {\n      burst(x, y);\n    }\n  }, { passive:true });\n\n  function burst(x, y) {\n    const count = 6;\n\n    for (let i = 0; i < count; i++) {\n      const p = document.createElement(\"div\");\n      p.className = \"particle\";\n\n      const size = 3 + Math.random() * 5;\n      p.style.width = size + \"px\";\n      p.style.height = size + \"px\";\n      p.style.left = (x - size / 2) + \"px\";\n      p.style.top = (y - size / 2) + \"px\";\n\n      scene.appendChild(p);\n\n      const angle = (Math.PI * 2 * i / count) + (Math.random() - .5) * .3;\n      const distance = 17 + Math.random() * 28;\n      const dx = Math.cos(angle) * distance;\n      const dy = Math.sin(angle) * distance;\n\n      const animation = p.animate([\n        {\n          opacity:.42,\n          transform:\"translate3d(0,0,0) scale(.7)\"\n        },\n        {\n          opacity:0,\n          transform:`translate3d(${dx}px,${dy}px,0) scale(1.1)`\n        }\n      ], {\n        duration:600 + Math.random() * 240,\n        easing:\"cubic-bezier(.2,.7,.25,1)\"\n      });\n\n      animation.onfinish = () => p.remove();\n    }\n  }\n\n  addEventListener(\"resize\", () => {\n    tx = 0;\n    ty = 0;\n  }, { passive:true });\n\n  addEventListener(\"pagehide\", () => {\n    if (raf) cancelAnimationFrame(raf);\n  }, { once:true });\n})();\n</script>\n\n</body>\n</html>\n","sectionHeadingBackgroundEnabledV59":false,"sectionHeadingBackgroundColorV59":"#ffffff","sectionHeadingBackgroundPaddingV59":6,"knowledgeCardOpacityV63":100,"dashboardTitleV69":"MY LOGS","svgHoverAnimationsEnabledV82":true,"svgHoverAnimationV82":"lift","svgHoverSoundStopModeV87":"immediate","svgHoverSoundStopDelayV87":0.1,"svgHoverSoundFadeOnStopV88":false,"dashboardCategorySelectedColorV85":"#cdcdcd","dashboardCategoryHoverColorV85":"#e4e4e4","decorationsOpacityV117":100,"introMusicReactionsEnabledV154":true,"backgroundModeV158":""}}]