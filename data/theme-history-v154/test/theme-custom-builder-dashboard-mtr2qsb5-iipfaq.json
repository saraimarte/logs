fff,#9e9e9e);\nborder:1px solid rgba(95,95,95,.16);\nopacity:0;\n}\n\n@keyframes ring {\nfrom {\nopacity:.48;\ntransform:translate3d(0,0,0) scale(.2);\n}\nto {\nopacity:0;\ntransform:translate3d(0,0,0) scale(8);\n}\n}\n\n@media (prefers-reduced-motion: reduce) {\n.sheen,\n.orbit,\n.disc,\n.crystal {\ntransform:none !important;\n}\n\n.ring.active {\nanimation-duration:1ms;\n}\n} </style>\n\n</head>\n<body>\n<div class=\"scene\" id=\"scene\">\n  <div class=\"mesh\"></div>\n  <div class=\"sheen\"></div>\n\n  <div class=\"orbit o1\"></div>\n  <div class=\"orbit o2\"></div>\n  <div class=\"orbit o3\"></div>\n\n  <div class=\"disc d1\"></div>\n  <div class=\"disc d2\"></div>\n  <div class=\"disc d3\"></div>\n\n  <div class=\"crystal c1\"></div>\n  <div class=\"crystal c2\"></div>\n  <div class=\"crystal c3\"></div>\n\n  <div class=\"star s1\"></div>\n  <div class=\"star s2\"></div>\n  <div class=\"star s3\"></div>\n  <div class=\"star s4\"></div>\n  <div class=\"star s5\"></div>\n  <div class=\"star s6\"></div>\n\n  <div class=\"ring\" id=\"ring\"></div>\n</div>\n\n<script>\n(() => {\n  const scene = document.getElementById(\"scene\");\n  const ring = document.getElementById(\"ring\");\n  const reduced = matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n\n  let tx = 0;\n  let ty = 0;\n  let cx = 0;\n  let cy = 0;\n  let raf = 0;\n\n  function animate() {\n    cx += (tx - cx) * 0.055;\n    cy += (ty - cy) * 0.055;\n\n    scene.style.setProperty(\"--px\", cx.toFixed(4));\n    scene.style.setProperty(\"--py\", cy.toFixed(4));\n\n    raf = requestAnimationFrame(animate);\n  }\n\n  if (!reduced) {\n    raf = requestAnimationFrame(animate);\n  }\n\n  addEventListener(\"pointermove\", event => {\n    if (reduced) return;\n\n    const w = Math.max(1, innerWidth);\n    const h = Math.max(1, innerHeight);\n\n    tx = Math.max(-1, Math.min(1, (event.clientX / w - .5) * 2));\n    ty = Math.max(-1, Math.min(1, (event.clientY / h - .5) * 2));\n  }, { passive:true });\n\n  addEventListener(\"pointerleave\", () => {\n    tx = 0;\n    ty = 0;\n  }, { passive:true });\n\n  addEventListener(\"pointerdown\", event => {\n    const x = Math.max(0, Math.min(innerWidth, event.clientX));\n    const y = Math.max(0, Math.min(innerHeight, event.clientY));\n\n    ring.classList.remove(\"active\");\n    ring.style.left = x + \"px\";\n    ring.style.top = y + \"px\";\n    void ring.offsetWidth;\n    ring.classList.add(\"active\");\n\n    if (!reduced) {\n      burst(x, y);\n    }\n  }, { passive:true });\n\n  function burst(x, y) {\n    const count = 6;\n\n    for (let i = 0; i < count; i++) {\n      const p = document.createElement(\"div\");\n      p.className = \"particle\";\n\n      const size = 3 + Math.random() * 5;\n      p.style.width = size + \"px\";\n      p.style.height = size + \"px\";\n      p.style.left = (x - size / 2) + \"px\";\n      p.style.top = (y - size / 2) + \"px\";\n\n      scene.appendChild(p);\n\n      const angle = (Math.PI * 2 * i / count) + (Math.random() - .5) * .3;\n      const distance = 17 + Math.random() * 28;\n      const dx = Math.cos(angle) * distance;\n      const dy = Math.sin(angle) * distance;\n\n      const animation = p.animate([\n        {\n          opacity:.42,\n          transform:\"translate3d(0,0,0) scale(.7)\"\n        },\n        {\n          opacity:0,\n          transform:`translate3d(${dx}px,${dy}px,0) scale(1.1)`\n        }\n      ], {\n        duration:600 + Math.random() * 240,\n        easing:\"cubic-bezier(.2,.7,.25,1)\"\n      });\n\n      animation.onfinish = () => p.remove();\n    }\n  }\n\n  addEventListener(\"resize\", () => {\n    tx = 0;\n    ty = 0;\n  }, { passive:true });\n\n  addEventListener(\"pagehide\", () => {\n    if (raf) cancelAnimationFrame(raf);\n  }, { once:true });\n})();\n</script>\n\n</body>\n</html>\n","sectionHeadingBackgroundEnabledV59":false,"sectionHeadingBackgroundColorV59":"#ffffff","sectionHeadingBackgroundPaddingV59":6,"knowledgeCardOpacityV63":100,"dashboardTitleV