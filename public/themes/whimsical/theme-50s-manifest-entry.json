/* ============================================================
   WORLD HISTORY
   Scoped visual theme. No global layout/cursor/companion overrides.
   ============================================================ */

body.theme-worldhistory {
    --theme-ink: #493b2f;
    --theme-paper: #fff8e9;
    --theme-accent: #9b6543;
    --theme-accent-2: #617f91;
    --theme-gold: #c79d54;

    --black: var(--theme-ink);
    --white: var(--theme-paper);
    --bg-overlay: transparent;

    --thick-border: 2px solid color-mix(in srgb, var(--theme-accent) 44%, transparent);
    --thin-border: 1px solid color-mix(in srgb, var(--theme-accent) 30%, transparent);
    --dashed-border: 1px dashed color-mix(in srgb, var(--theme-accent) 30%, transparent);
    --dotted-border: 1px dotted color-mix(in srgb, var(--theme-accent) 30%, transparent);

    --track-bg: color-mix(in srgb, var(--theme-accent) 12%, transparent);
    --muted-text: color-mix(in srgb, var(--theme-ink) 58%, transparent);

    background:
        radial-gradient(circle at 50% 4%, color-mix(in srgb, var(--theme-accent-2) 16%, transparent), transparent 34%),
        radial-gradient(circle at 12% 80%, color-mix(in srgb, var(--theme-accent) 12%, transparent), transparent 30%),
        linear-gradient(145deg, #efe0c2, #dfe6e5) !important;

    background-attachment: fixed !important;
    color: var(--theme-ink);
}

#worldhistory-background {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    z-index: 0;
}

#worldhistory-background .theme-worldhistory-haze {
    position: absolute;
    inset: 0;
    background:
        radial-gradient(circle at 50% 14%, color-mix(in srgb, var(--theme-paper) 42%, transparent), transparent 34%),
        radial-gradient(circle at 15% 55%, color-mix(in srgb, var(--theme-accent) 10%, transparent), transparent 30%),
        radial-gradient(circle at 85% 58%, color-mix(in srgb, var(--theme-accent-2) 10%, transparent), transparent 30%);
}

#worldhistory-background .theme-worldhistory-pattern {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(45deg, rgba(155,101,67,.05) 0 1px, transparent 1px 24px);
    background-size: 80px 80px;
    opacity: .65;
}

#worldhistory-background .theme-worldhistory-horizon {
    position: absolute;
    left: -7vw;
    right: -7vw;
    bottom: -8vh;
    height: 29vh;
    background:
        linear-gradient(180deg, transparent, color-mix(in srgb, var(--theme-accent) 8%, transparent) 35%, color-mix(in srgb, var(--theme-ink) 12%, transparent));
    clip-path: polygon(0 35%, 100% 12%, 100% 100%, 0 100%);
    opacity: .65;
}

#worldhistory-background .theme-worldhistory-item {
    position: absolute;
    width: 125px;
    height: 125px;
    color: color-mix(in srgb, var(--theme-ink) 82%, var(--theme-accent));
    opacity: .30;
    transform:
        translate3d(-50%, -50%, 0)
        rotate(var(--item-rotate))
        scale(var(--item-scale));
    filter:
        drop-shadow(0 8px 13px rgba(0,0,0,.16))
        drop-shadow(0 0 9px color-mix(in srgb, var(--theme-accent) 16%, transparent));
    animation:
        themeWorldhistoryFloat
        7.8s
        ease-in-out
        var(--item-delay)
        infinite;
    transform-origin: center center;
    will-change: transform;
    pointer-events: none;
}

#worldhistory-background .theme-worldhistory-item svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
    pointer-events: none;
}

#worldhistory-background .theme-worldhistory-item:nth-of-type(3n) {
    width: 105px;
    height: 105px;
    opacity: .24;
}

#worldhistory-background .theme-worldhistory-item:nth-of-type(4n) {
    animation-duration: 9.4s;
}

@keyframes themeWorldhistoryFloat {
    0%,100% {
        transform:
            translate3d(-50%, -50%, 0)
            translate3d(0,0,0)
            rotate(var(--item-rotate))
            scale(var(--item-scale));
    }
    50% {
        transform:
            translate3d(-50%, -50%, 0)
            translate3d(var(--item-x), var(--item-y), 0)
            rotate(calc(var(--item-rotate) + 2deg))
            scale(var(--item-scale));
    }
}

#worldhistory-background .theme-worldhistory-react {
    opacity: .56;
    filter:
        drop-shadow(0 10px 16px rgba(0,0,0,.20))
        drop-shadow(0 0 14px color-mix(in srgb, var(--theme-accent) 34%, transparent));
    animation:
        themeWorldhistoryReact
        .5s
        ease-out !important;
}

@keyframes themeWorldhistoryReact {
    0% {
        transform:
            translate3d(-50%, -50%, 0)
            rotate(var(--item-rotate))
            scale(var(--item-scale));
    }
    45% {
        transform:
            translate3d(-50%, -50%, 0)
            translate3d(0,-10px,0)
            rotate(calc(var(--item-rotate) + 7deg))
            scale(calc(var(--item-scale) * 1.09));
    }
    100% {
        transform:
            translate3d(-50%, -50%, 0)
            rotate(var(--item-rotate))
            scale(var(--item-scale));
    }
}

/* UI adaptation only. Sizes and positions remain template-owned. */
body.theme-worldhistory .day-box,
body.theme-worldhistory .day-picker-box,
body.theme-worldhistory .icon-btn,
body.theme-worldhistory .small-icon-btn,
body.theme-worldhistory input,
body.theme-worldhistory textarea,
body.theme-worldhistory select,
body.theme-worldhistory .notes-editable,
body.theme-worldhistory .phrase-card,
body.theme-worldhistory .chip,
body.theme-worldhistory .toolbox-item,
body.theme-worldhistory .resource-card,
body.theme-worldhistory .polaroid-card,
body.theme-worldhistory .filter-tab,
body.theme-worldhistory .day-target-box,
body.theme-worldhistory .flashcard,
body.theme-worldhistory .flashcard-mode-card,
body.theme-worldhistory .day-badge,
body.theme-worldhistory .video-placeholder,
body.theme-worldhistory .theme-picker-card,
body.theme-worldhistory .note-audio-row,
body.theme-worldhistory .modal-box {
    background-color: color-mix(in srgb, var(--theme-paper) 91%, transparent);
    color: var(--theme-ink);
    border-color: color-mix(in srgb, var(--theme-accent) 28%, transparent);
}

body.theme-worldhistory input::placeholder,
body.theme-worldhistory textarea::placeholder,
body.theme-worldhistory .notes-editable:empty::before {
    color: color-mix(in srgb, var(--theme-ink) 43%, transparent);
}

body.theme-worldhistory .icon-btn:hover,
body.theme-worldhistory .small-icon-btn:hover,
body.theme-worldhistory .filter-tab:hover {
    background: color-mix(in srgb, var(--theme-accent) 14%, var(--theme-paper));
    color: var(--theme-ink);
}

body.theme-worldhistory .chip:hover,
body.theme-worldhistory .phrase-card:hover,
body.theme-worldhistory .filter-tab.active,
body.theme-worldhistory .day-picker-box.selected {
    background:
        linear-gradient(
            135deg,
            color-mix(in srgb, var(--theme-accent) 90%, var(--theme-paper)),
            color-mix(in srgb, var(--theme-accent-2) 76%, var(--theme-paper))
        );
    color: var(--theme-paper);
    border-color: color-mix(in srgb, var(--theme-accent) 58%, transparent);
}

body.theme-worldhistory .progress-bar-track {
    background: color-mix(in srgb, var(--theme-accent) 12%, transparent);
}

body.theme-worldhistory .progress-bar-fill {
    background:
        linear-gradient(
            90deg,
            var(--theme-accent),
            var(--theme-gold),
            var(--theme-accent-2)
        );
}

/* Safe stacking: no broad direct-child wildcard selectors. */
body.theme-worldhistory #worldhistory-background {
    z-index: 0;
}

body.theme-worldhistory .view {
    position: relative;
    z-index: 2;
}

body.theme-worldhistory .side-nav {
    position: relative;
    z-index: 3;
}

body.theme-worldhistory header,
body.theme-worldhistory .log-header-container {
    position: relative;
    z-index: 4;
}

body.theme-worldhistory .modal,
body.theme-worldhistory .modal-overlay,
body.theme-worldhistory .overlay {
    z-index: 10;
}

@media (max-width: 700px) {
    #worldhistory-background .theme-worldhistory-item {
        width: 94px;
        height: 94px;
        opacity: .21;
    }

    #worldhistory-background .theme-worldhistory-item:nth-of-type(2n) {
        opacity: .14;
    }
}

@media (prefers-reduced-motion: reduce) {
    #worldhistory-background * {
        animation: none !important;
    }
}
