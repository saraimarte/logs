/* ============================================================
   PIANO
   Scoped visual theme. No global layout/cursor/companion overrides.
   ============================================================ */

body.theme-piano {
    --theme-ink: #f5efe5;
    --theme-paper: #201c22;
    --theme-accent: #b45770;
    --theme-accent-2: #d6b16a;
    --theme-gold: #d6b16a;

    --black: var(--theme-ink);
    --white: var(--theme-paper);
    --bg-overlay: transparent;

    --thick-border: 2px solid color-mix(in srgb, var(--theme-accent) 44%, transparent);
    --thin-border: 1px solid color-mix(in srgb, var(--theme-accent) 30%, transparent);
    --dashed-border: 1px dashed color-mix(in srgb, var(--theme-accent) 30%, transparent);
    --dotted-border: 1px dotted color-mix(in srgb, var(--theme-accent) 30%, transparent);

    --track-bg: color-mix(in srgb, var(--theme-accent) 12%, transparent);
    --muted-text: color-mix(in srgb, var(--theme-ink) 58%, transparent);

    background:
        radial-gradient(circle at 50% 4%, color-mix(in srgb, var(--theme-accent-2) 16%, transparent), transparent 34%),
        radial-gradient(circle at 12% 80%, color-mix(in srgb, var(--theme-accent) 12%, transparent), transparent 30%),
        linear-gradient(145deg, #16131a, #2b222b) !important;

    background-attachment: fixed !important;
    color: var(--theme-ink);
}

#piano-background {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    z-index: 0;
}

#piano-background .theme-piano-haze {
    position: absolute;
    inset: 0;
    background:
        radial-gradient(circle at 50% 14%, color-mix(in srgb, var(--theme-paper) 42%, transparent), transparent 34%),
        radial-gradient(circle at 15% 55%, color-mix(in srgb, var(--theme-accent) 10%, transparent), transparent 30%),
        radial-gradient(circle at 85% 58%, color-mix(in srgb, var(--theme-accent-2) 10%, transparent), transparent 30%);
}

#piano-background .theme-piano-pattern {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(90deg, rgba(255,255,255,.05) 0 24px, transparent 24px 48px);
    background-size: 80px 80px;
    opacity: .65;
}

#piano-background .theme-piano-horizon {
    position: absolute;
    left: -7vw;
    right: -7vw;
    bottom: -8vh;
    height: 29vh;
    background:
        linear-gradient(180deg, transparent, color-mix(in srgb, var(--theme-accent) 8%, transparent) 35%, color-mix(in srgb, var(--theme-ink) 12%, transparent));
    clip-path: polygon(0 35%, 100% 12%, 100% 100%, 0 100%);
    opacity: .65;
}

#piano-background .theme-piano-item {
    position: absolute;
    width: 125px;
    height: 125px;
    color: color-mix(in srgb, var(--theme-ink) 82%, var(--theme-accent));
    opacity: .30;
    transform:
        translate3d(-50%, -50%, 0)
        rotate(var(--item-rotate))
        scale(var(--item-scale));
    filter:
        drop-shadow(0 8px 13px rgba(0,0,0,.16))
        drop-shadow(0 0 9px color-mix(in srgb, var(--theme-accent) 16%, transparent));
    animation:
        themePianoFloat
        7.8s
        ease-in-out
        var(--item-delay)
        infinite;
    transform-origin: center center;
    will-change: transform;
    pointer-events: none;
}

#piano-background .theme-piano-item svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
    pointer-events: none;
}

#piano-background .theme-piano-item:nth-of-type(3n) {
    width: 105px;
    height: 105px;
    opacity: .24;
}

#piano-background .theme-piano-item:nth-of-type(4n) {
    animation-duration: 9.4s;
}

@keyframes themePianoFloat {
    0%,100% {
        transform:
            translate3d(-50%, -50%, 0)
            translate3d(0,0,0)
            rotate(var(--item-rotate))
            scale(var(--item-scale));
    }
    50% {
        transform:
            translate3d(-50%, -50%, 0)
            translate3d(var(--item-x), var(--item-y), 0)
            rotate(calc(var(--item-rotate) + 2deg))
            scale(var(--item-scale));
    }
}

#piano-background .theme-piano-react {
    opacity: .56;
    filter:
        drop-shadow(0 10px 16px rgba(0,0,0,.20))
        drop-shadow(0 0 14px color-mix(in srgb, var(--theme-accent) 34%, transparent));
    animation:
        themePianoReact
        .5s
        ease-out !important;
}

@keyframes themePianoReact {
    0% {
        transform:
            translate3d(-50%, -50%, 0)
            rotate(var(--item-rotate))
            scale(var(--item-scale));
    }
    45% {
        transform:
            translate3d(-50%, -50%, 0)
            translate3d(0,-10px,0)
            rotate(calc(var(--item-rotate) + 7deg))
            scale(calc(var(--item-scale) * 1.09));
    }
    100% {
        transform:
            translate3d(-50%, -50%, 0)
            rotate(var(--item-rotate))
            scale(var(--item-scale));
    }
}

/* UI adaptation only. Sizes and positions remain template-owned. */
body.theme-piano .day-box,
body.theme-piano .day-picker-box,
body.theme-piano .icon-btn,
body.theme-piano .small-icon-btn,
body.theme-piano input,
body.theme-piano textarea,
body.theme-piano select,
body.theme-piano .notes-editable,
body.theme-piano .phrase-card,
body.theme-piano .chip,
body.theme-piano .toolbox-item,
body.theme-piano .resource-card,
body.theme-piano .polaroid-card,
body.theme-piano .filter-tab,
body.theme-piano .day-target-box,
body.theme-piano .flashcard,
body.theme-piano .flashcard-mode-card,
body.theme-piano .day-badge,
body.theme-piano .video-placeholder,
body.theme-piano .theme-picker-card,
body.theme-piano .note-audio-row,
body.theme-piano .modal-box {
    background-color: color-mix(in srgb, var(--theme-paper) 91%, transparent);
    color: var(--theme-ink);
    border-color: color-mix(in srgb, var(--theme-accent) 28%, transparent);
}

body.theme-piano input::placeholder,
body.theme-piano textarea::placeholder,
body.theme-piano .notes-editable:empty::before {
    color: color-mix(in srgb, var(--theme-ink) 43%, transparent);
}

body.theme-piano .icon-btn:hover,
body.theme-piano .small-icon-btn:hover,
body.theme-piano .filter-tab:hover {
    background: color-mix(in srgb, var(--theme-accent) 14%, var(--theme-paper));
    color: var(--theme-ink);
}

body.theme-piano .chip:hover,
body.theme-piano .phrase-card:hover,
body.theme-piano .filter-tab.active,
body.theme-piano .day-picker-box.selected {
    background:
        linear-gradient(
            135deg,
            color-mix(in srgb, var(--theme-accent) 90%, var(--theme-paper)),
            color-mix(in srgb, var(--theme-accent-2) 76%, var(--theme-paper))
        );
    color: var(--theme-paper);
    border-color: color-mix(in srgb, var(--theme-accent) 58%, transparent);
}

body.theme-piano .progress-bar-track {
    background: color-mix(in srgb, var(--theme-accent) 12%, transparent);
}

body.theme-piano .progress-bar-fill {
    background:
        linear-gradient(
            90deg,
            var(--theme-accent),
            var(--theme-gold),
            var(--theme-accent-2)
        );
}

/* Safe stacking: no broad direct-child wildcard selectors. */
body.theme-piano #piano-background {
    z-index: 0;
}

body.theme-piano .view {
    position: relative;
    z-index: 2;
}

body.theme-piano .side-nav {
    position: relative;
    z-index: 3;
}

body.theme-piano header,
body.theme-piano .log-header-container {
    position: relative;
    z-index: 4;
}

body.theme-piano .modal,
body.theme-piano .modal-overlay,
body.theme-piano .overlay {
    z-index: 10;
}

@media (max-width: 700px) {
    #piano-background .theme-piano-item {
        width: 94px;
        height: 94px;
        opacity: .21;
    }

    #piano-background .theme-piano-item:nth-of-type(2n) {
        opacity: .14;
    }
}

@media (prefers-reduced-motion: reduce) {
    #piano-background * {
        animation: none !important;
    }
}
