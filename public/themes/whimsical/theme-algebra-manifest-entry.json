/* ============================================================
   Y2K
   Scoped visual theme. No global layout/cursor/companion overrides.
   ============================================================ */

body.theme-y2k {
    --theme-ink: #43264d;
    --theme-paper: #fff5ff;
    --theme-accent: #f06db1;
    --theme-accent-2: #6fd7da;
    --theme-gold: #d7b7f0;

    --black: var(--theme-ink);
    --white: var(--theme-paper);
    --bg-overlay: transparent;

    --thick-border: 2px solid color-mix(in srgb, var(--theme-accent) 44%, transparent);
    --thin-border: 1px solid color-mix(in srgb, var(--theme-accent) 30%, transparent);
    --dashed-border: 1px dashed color-mix(in srgb, var(--theme-accent) 30%, transparent);
    --dotted-border: 1px dotted color-mix(in srgb, var(--theme-accent) 30%, transparent);

    --track-bg: color-mix(in srgb, var(--theme-accent) 12%, transparent);
    --muted-text: color-mix(in srgb, var(--theme-ink) 58%, transparent);

    background:
        radial-gradient(circle at 50% 4%, color-mix(in srgb, var(--theme-accent-2) 16%, transparent), transparent 34%),
        radial-gradient(circle at 12% 80%, color-mix(in srgb, var(--theme-accent) 12%, transparent), transparent 30%),
        linear-gradient(145deg, #ffd8f1, #cceeff) !important;

    background-attachment: fixed !important;
    color: var(--theme-ink);
}

#y2k-background {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    z-index: 0;
}

#y2k-background .theme-y2k-haze {
    position: absolute;
    inset: 0;
    background:
        radial-gradient(circle at 50% 14%, color-mix(in srgb, var(--theme-paper) 42%, transparent), transparent 34%),
        radial-gradient(circle at 15% 55%, color-mix(in srgb, var(--theme-accent) 10%, transparent), transparent 30%),
        radial-gradient(circle at 85% 58%, color-mix(in srgb, var(--theme-accent-2) 10%, transparent), transparent 30%);
}

#y2k-background .theme-y2k-pattern {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 20px 20px, rgba(240,109,177,.12) 0 5px, transparent 6px),radial-gradient(circle at 60px 60px, rgba(111,215,218,.12) 0 5px, transparent 6px);
    background-size: 80px 80px;
    opacity: .65;
}

#y2k-background .theme-y2k-horizon {
    position: absolute;
    left: -7vw;
    right: -7vw;
    bottom: -8vh;
    height: 29vh;
    background:
        linear-gradient(180deg, transparent, color-mix(in srgb, var(--theme-accent) 8%, transparent) 35%, color-mix(in srgb, var(--theme-ink) 12%, transparent));
    clip-path: polygon(0 35%, 100% 12%, 100% 100%, 0 100%);
    opacity: .65;
}

#y2k-background .theme-y2k-item {
    position: absolute;
    width: 125px;
    height: 125px;
    color: color-mix(in srgb, var(--theme-ink) 82%, var(--theme-accent));
    opacity: .30;
    transform:
        translate3d(-50%, -50%, 0)
        rotate(var(--item-rotate))
        scale(var(--item-scale));
    filter:
        drop-shadow(0 8px 13px rgba(0,0,0,.16))
        drop-shadow(0 0 9px color-mix(in srgb, var(--theme-accent) 16%, transparent));
    animation:
        themeY2KFloat
        7.8s
        ease-in-out
        var(--item-delay)
        infinite;
    transform-origin: center center;
    will-change: transform;
    pointer-events: none;
}

#y2k-background .theme-y2k-item svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
    pointer-events: none;
}

#y2k-background .theme-y2k-item:nth-of-type(3n) {
    width: 105px;
    height: 105px;
    opacity: .24;
}

#y2k-background .theme-y2k-item:nth-of-type(4n) {
    animation-duration: 9.4s;
}

@keyframes themeY2KFloat {
    0%,100% {
        transform:
            translate3d(-50%, -50%, 0)
            translate3d(0,0,0)
            rotate(var(--item-rotate))
            scale(var(--item-scale));
    }
    50% {
        transform:
            translate3d(-50%, -50%, 0)
            translate3d(var(--item-x), var(--item-y), 0)
            rotate(calc(var(--item-rotate) + 2deg))
            scale(var(--item-scale));
    }
}

#y2k-background .theme-y2k-react {
    opacity: .56;
    filter:
        drop-shadow(0 10px 16px rgba(0,0,0,.20))
        drop-shadow(0 0 14px color-mix(in srgb, var(--theme-accent) 34%, transparent));
    animation:
        themeY2KReact
        .5s
        ease-out !important;
}

@keyframes themeY2KReact {
    0% {
        transform:
            translate3d(-50%, -50%, 0)
            rotate(var(--item-rotate))
            scale(var(--item-scale));
    }
    45% {
        transform:
            translate3d(-50%, -50%, 0)
            translate3d(0,-10px,0)
            rotate(calc(var(--item-rotate) + 7deg))
            scale(calc(var(--item-scale) * 1.09));
    }
    100% {
        transform:
            translate3d(-50%, -50%, 0)
            rotate(var(--item-rotate))
            scale(var(--item-scale));
    }
}

/* UI adaptation only. Sizes and positions remain template-owned. */
body.theme-y2k .day-box,
body.theme-y2k .day-picker-box,
body.theme-y2k .icon-btn,
body.theme-y2k .small-icon-btn,
body.theme-y2k input,
body.theme-y2k textarea,
body.theme-y2k select,
body.theme-y2k .notes-editable,
body.theme-y2k .phrase-card,
body.theme-y2k .chip,
body.theme-y2k .toolbox-item,
body.theme-y2k .resource-card,
body.theme-y2k .polaroid-card,
body.theme-y2k .filter-tab,
body.theme-y2k .day-target-box,
body.theme-y2k .flashcard,
body.theme-y2k .flashcard-mode-card,
body.theme-y2k .day-badge,
body.theme-y2k .video-placeholder,
body.theme-y2k .theme-picker-card,
body.theme-y2k .note-audio-row,
body.theme-y2k .modal-box {
    background-color: color-mix(in srgb, var(--theme-paper) 91%, transparent);
    color: var(--theme-ink);
    border-color: color-mix(in srgb, var(--theme-accent) 28%, transparent);
}

body.theme-y2k input::placeholder,
body.theme-y2k textarea::placeholder,
body.theme-y2k .notes-editable:empty::before {
    color: color-mix(in srgb, var(--theme-ink) 43%, transparent);
}

body.theme-y2k .icon-btn:hover,
body.theme-y2k .small-icon-btn:hover,
body.theme-y2k .filter-tab:hover {
    background: color-mix(in srgb, var(--theme-accent) 14%, var(--theme-paper));
    color: var(--theme-ink);
}

body.theme-y2k .chip:hover,
body.theme-y2k .phrase-card:hover,
body.theme-y2k .filter-tab.active,
body.theme-y2k .day-picker-box.selected {
    background:
        linear-gradient(
            135deg,
            color-mix(in srgb, var(--theme-accent) 90%, var(--theme-paper)),
            color-mix(in srgb, var(--theme-accent-2) 76%, var(--theme-paper))
        );
    color: var(--theme-paper);
    border-color: color-mix(in srgb, var(--theme-accent) 58%, transparent);
}

body.theme-y2k .progress-bar-track {
    background: color-mix(in srgb, var(--theme-accent) 12%, transparent);
}

body.theme-y2k .progress-bar-fill {
    background:
        linear-gradient(
            90deg,
            var(--theme-accent),
            var(--theme-gold),
            var(--theme-accent-2)
        );
}

/* Safe stacking: no broad direct-child wildcard selectors. */
body.theme-y2k #y2k-background {
    z-index: 0;
}

body.theme-y2k .view {
    position: relative;
    z-index: 2;
}

body.theme-y2k .side-nav {
    position: relative;
    z-index: 3;
}

body.theme-y2k header,
body.theme-y2k .log-header-container {
    position: relative;
    z-index: 4;
}

body.theme-y2k .modal,
body.theme-y2k .modal-overlay,
body.theme-y2k .overlay {
    z-index: 10;
}

@media (max-width: 700px) {
    #y2k-background .theme-y2k-item {
        width: 94px;
        height: 94px;
        opacity: .21;
    }

    #y2k-background .theme-y2k-item:nth-of-type(2n) {
        opacity: .14;
    }
}

@media (prefers-reduced-motion: reduce) {
    #y2k-background * {
        animation: none !important;
    }
}
